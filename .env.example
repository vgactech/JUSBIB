# JUSLIB — Variables d'environnement
# Copier en .env et remplir les valeurs

# --- Légifrance (API PISTE — gratuit) ---
# Obtenir sur : https://developer.aife.economie.gouv.fr/
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# --- CanLII (Canada/Québec) ---
# Obtenir sur : https://developer.canlii.org/
CANLII_API_KEY=

# --- JUSLIB Settings ---
JUSLIB_DEBUG=true
JUSLIB_PORT=8765
JUSLIB_CORPUS_DIR=data/corpus
JUSLIB_DB_URL=sqlite:///data/juslib.db

# --- LLM (optionnel — enrichissement vulgarisation) ---
# Si configuré : les niveaux INTERMEDIATE et CITIZEN bénéficient de l'enrichissement IA
# Le marquage [GÉNÉRÉ PAR IA] est TOUJOURS ajouté automatiquement
JUSLIB_LLM_ENABLED=false
BOB_API_KEY=

# --- EUR-Lex, HUDOC, UN ODS --- public, pas de clé requise

# --- GitHub (versionnement releases) ---
GITHUB_TOKEN=
